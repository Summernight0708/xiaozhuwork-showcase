{
  "name": "xiaozhuwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "dev:ops": "vite --config vite.ops.config.ts",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:ops": "vite build --config vite.ops.config.ts",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && prettier --check --end-of-line auto \"src/**/*.{ts,vue,css}\" \"src-ops/**/*.{ts,vue,css,html}\" \"src-shared/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,js,yaml,yml,html}\" \"../.github/**/*.{yaml,yml}\" && python scripts/check-xiaozhuwork-brand.py",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:ops": "vue-tsc --noEmit -p tsconfig.ops.json",
    "test": "vitest run",
    "test:ops": "vitest run tests/unit/ops-",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:concurrency": "vitest run --config vitest.db.config.ts",
    "db:test:storage": "node scripts/run-storage-integration.mjs",
    "probe:report-pdf": "node scripts/probe-report-pdf.ts",
    "probe:report-edge": "node scripts/probe-report-edge.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm typecheck:ops && corepack pnpm test && corepack pnpm test:ops && corepack pnpm build && corepack pnpm build:ops && corepack pnpm test:e2e && corepack pnpm db:reset && corepack pnpm db:test && corepack pnpm db:test:concurrency && corepack pnpm db:test:storage && corepack pnpm db:types:check",
    "android:sync": "corepack pnpm build && corepack pnpm exec cap sync android",
    "android:debug": "corepack pnpm android:sync && node scripts/android-gradle.mjs assembleDebug",
    "android:release": "node scripts/android-release-gate.mjs preflight && corepack pnpm android:sync && node scripts/android-gradle.mjs assembleRelease && node scripts/android-release-gate.mjs verify",
    "android:assets": "corepack pnpm exec capacitor-assets generate --android",
    "test:auth:soft-delete:disposable": "node scripts/verify-gotrue-soft-delete.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "brand:audit": "python scripts/check-xiaozhuwork-brand.py"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@sentry/vue": "^10.17.0",
    "@supabase/supabase-js": "^2.57.4",
    "dompurify": "3.4.16",
    "mammoth": "1.13.0",
    "pdfjs-dist": "4.10.38",
    "pinia": "^3.0.3",
    "read-excel-file": "9.3.10",
    "vant": "^4.9.21",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^26.1.0",
    "postgres": "3.4.9",
    "prettier": "^3.6.2",
    "supabase": "2.118.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.8"
  }
}
