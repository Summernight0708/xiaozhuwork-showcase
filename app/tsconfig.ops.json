{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src-ops/**/*.ts",
    "src-ops/**/*.tsx",
    "src-ops/**/*.vue",
    "src-shared/**/*.ts",
    "tests/unit/ops-*.spec.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ops/*": ["./src-ops/*"],
      "@shared/*": ["./src-shared/*"]
    },
    "types": ["vitest/globals"]
  }
}
